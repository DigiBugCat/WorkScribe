{
  "name": "workscribe-obsidian",
  "version": "0.1.0",
  "description": "Obsidian workspace for WorkScribe: live enhanced notes, cited answers, moments search.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node esbuild.config.mjs tests && node --test .test-build/*.test.mjs",
    "smoke": "node dev/smoke-load.mjs",
    "mock": "node dev/mock-server.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/markdown": "^1.8.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "obsidian": "^1.14.4",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
