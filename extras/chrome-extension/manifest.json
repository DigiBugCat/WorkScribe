{
  "manifest_version": 3,
  "name": "WorkScribe Clip",
  "version": "0.1.0",
  "description": "Clip the current page into the meeting WorkScribe is recording, or ask WorkScribe about it. Acts only when you click.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Clip to WorkScribe", "default_popup": "popup.html" }
}
