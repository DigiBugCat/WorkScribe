{
  "schemaVersion": "0.1.0",
  "name": "WorkScribe clip",
  "behavior": "create",
  "noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}} {{title|safe_name}}",
  "path": "Clippings",
  "noteContentFormat": "{{content}}",
  "properties": [
    { "name": "type", "value": "clip", "type": "text" },
    { "name": "title", "value": "{{title}}", "type": "text" },
    { "name": "source", "value": "{{url}}", "type": "text" },
    { "name": "site", "value": "{{site}}", "type": "text" },
    { "name": "author", "value": "{{author|split:\", \"|wikilink|join}}", "type": "multitext" },
    { "name": "published", "value": "{{published}}", "type": "date" },
    { "name": "clipped", "value": "{{date}}", "type": "datetime" },
    { "name": "description", "value": "{{description}}", "type": "text" },
    { "name": "highlights", "value": "{{highlights|map:item => item.text|join:\"\\n\"}}", "type": "multitext" },
    { "name": "tags", "value": "clippings", "type": "multitext" }
  ],
  "triggers": []
}
